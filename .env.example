# ==============================================================================
# SMARTFIN AI — ROOT MONOREPO CONFIGURATION TEMPLATE
# Copy to individual services (backend/.env, frontend/.env, ml-service/.env)
# ==============================================================================

# Common Runtime
NODE_ENV=development
APP_NAME=SmartFinAI

# Backend Configuration (backend/.env)
BACKEND_PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartfin_ai_dev
REDIS_HOST=localhost
REDIS_PORT=6379

# Machine Learning Service (ml-service/.env)
ML_SERVICE_PORT=8000
ML_SERVICE_SECRET_TOKEN=change_this_to_a_secure_random_string_32_chars

# Frontend Configuration (frontend/.env)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_ML_SERVICE_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:5000
