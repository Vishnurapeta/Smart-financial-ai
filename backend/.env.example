# ==============================================================================
# SMARTFIN AI — BACKEND SERVER (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=SmartFinAI-Backend
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Persistence & Caching
MONGODB_URI=mongodb://localhost:27017/smartfin_ai_dev
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Machine Learning Service Integration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET_TOKEN=change_this_to_a_secure_token_min_32_chars

# External Market Data Provider Integration
# Options: yahoo | finnhub | alphavantage | twelvedata
MARKET_DATA_PROVIDER=yahoo
# Optional for Yahoo; required for Finnhub, Alpha Vantage, Twelve Data
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_CACHE_TTL_QUOTE=60
MARKET_DATA_CACHE_TTL_HISTORY=900
MARKET_DATA_CACHE_TTL_SEARCH=3600

